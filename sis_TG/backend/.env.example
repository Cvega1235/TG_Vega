DATABASE_URL=postgresql://don_piotr:password@localhost:5432/don_piotr_db
SECRET_KEY=change-this-to-a-random-64-character-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
SUPERADMIN_EMAIL=admin@donpiotr.com
SUPERADMIN_PASSWORD=admin123

# TripAdvisor API (opcional)
TRIPADVISOR_API_KEY=your-api-key-here

# Email SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
